generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemKind {
  PAPER
  REPOSITORY
}

enum InstallDifficulty {
  UNKNOWN
  EASY
  MEDIUM
  HARD
}

enum Locale {
  EN
  ZH
}

model Item {
  id           String      @id @default(cuid())
  kind         ItemKind
  sourceUrl    String?     @db.Text
  canonicalUrl String?     @unique @db.Text
  important    Boolean     @default(false)
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  paper        Paper?
  repository   Repository?
  summaries    Summary[]
  notes        Note[]
  tags         ItemTag[]

  @@index([kind, archived, important, createdAt])
  @@map("items")
}

model Paper {
  id               String    @id @default(cuid())
  itemId           String    @unique
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title            String
  authors          String[]  @default([])
  venue            String?
  publishedAt      DateTime?
  revisedAt        DateTime?
  arxivId          String?   @unique
  doi              String?   @unique
  landingUrl       String?   @db.Text
  pdfUrl           String?   @db.Text
  abstract         String?   @db.Text
  problemStatement String?   @db.Text
  methodology      String?   @db.Text
  keyFindings      String?   @db.Text
  limitations      String?   @db.Text
  analysis         Json?
  relevanceScore   Int?
  relevanceNotes   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([publishedAt])
  @@index([relevanceScore])
  @@map("papers")
}

model Repository {
  id                 String            @id @default(cuid())
  itemId             String            @unique
  item               Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name               String
  url                String            @unique @db.Text
  owner              String
  description        String?           @db.Text
  stars              Int               @default(0)
  forks              Int               @default(0)
  primaryLanguage    String?
  lastUpdatedAt      DateTime?
  readme             String?           @db.Text
  techStack          String[]          @default([])
  installDifficulty  InstallDifficulty @default(UNKNOWN)
  installNotes       String?           @db.Text
  researchValueScore Int?
  researchValueNotes String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([owner, name])
  @@index([stars])
  @@index([lastUpdatedAt])
  @@index([researchValueScore])
  @@map("repositories")
}

model Summary {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language      Locale
  headline      String?
  summary       String   @db.Text
  keyPoints     String[] @default([])
  generatedBy   String?
  promptVersion String?
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemId, language])
  @@index([language])
  @@map("summaries")
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameZh    String?
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     ItemTag[]

  @@index([nameEn])
  @@map("tags")
}

model ItemTag {
  itemId    String
  tagId     String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}

model Note {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language  Locale
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, language])
  @@index([language])
  @@map("notes")
}
