# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# LLM provider settings used by summarization features.
LLM_API_KEY="replace-with-provider-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.2"
LLM_TIMEOUT_MS="30000"

# GitHub API token used by repository metadata and trending fetchers.
GITHUB_TOKEN="github_pat_replace_me"

# Optional defaults for the arXiv keyword daily fetch route.
ARXIV_DAILY_KEYWORDS="llm,retrieval,agents"
ARXIV_DAILY_MAX_RESULTS="10"

# Optional defaults for the GitHub trending fetch route.
GITHUB_TRENDING_KEYWORDS="rag,llm,agent"
GITHUB_TRENDING_TOPICS="artificial-intelligence,machine-learning"
GITHUB_TRENDING_MAX_RESULTS="10"
GITHUB_TRENDING_MIN_STARS="50"
GITHUB_TRENDING_LOOKBACK_DAYS="7"
