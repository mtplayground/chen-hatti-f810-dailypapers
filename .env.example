# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# LLM provider settings used by summarization features.
LLM_API_KEY="replace-with-provider-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.2"
LLM_TIMEOUT_MS="30000"

# GitHub API token used by repository metadata and fastest-growing fetches.
GITHUB_TOKEN="github_pat_replace_me"

# Optional defaults for the arXiv keyword daily fetch route.
ARXIV_DAILY_KEYWORDS="llm,retrieval,agents"
ARXIV_DAILY_MAX_RESULTS="10"

# Optional defaults for Hugging Face Daily Papers Top-5 ingestion.
HUGGINGFACE_DAILY_PAPERS_MAX_RESULTS="5"

# Optional defaults for the GitHub fastest-growing Top-5 approximation.
GITHUB_FAST_GROWING_MAX_RESULTS="5"
GITHUB_FAST_GROWING_LOOKBACK_DAYS="7"
GITHUB_FAST_GROWING_CANDIDATE_LIMIT="25"
